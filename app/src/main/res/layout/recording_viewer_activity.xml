<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/activity_horizontal_margin">

        <!-- Main camera video -->
        <TextView
            android:id="@+id/label_video_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Main Camera"
            android:textAppearance="?attr/textAppearanceListItem"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/video_main_container"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@android:color/black">

            <TextureView
                android:id="@+id/video_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/video_main_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/text_margin">

            <ImageButton
                android:id="@+id/button_playpause_main"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/play_pause_content_description"
                android:src="@drawable/ic_baseline_play_arrow_24" />

            <ImageButton
                android:id="@+id/button_rotate_main"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/rotate_video_content_description"
                android:src="@drawable/ic_baseline_rotate_90_24" />

            <SeekBar
                android:id="@+id/seekbar_main"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/video_main_fallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/text_margin"
            android:text="@string/no_video_available"
            android:visibility="gone" />

        <!-- Front camera video -->
        <TextView
            android:id="@+id/label_video_front"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/text_margin"
            android:text="Front Camera"
            android:textAppearance="?attr/textAppearanceListItem"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/video_front_container"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@android:color/black">

            <TextureView
                android:id="@+id/video_front"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/video_front_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/text_margin">

            <ImageButton
                android:id="@+id/button_playpause_front"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/play_pause_content_description"
                android:src="@drawable/ic_baseline_play_arrow_24" />

            <ImageButton
                android:id="@+id/button_rotate_front"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/rotate_video_content_description"
                android:src="@drawable/ic_baseline_rotate_90_24" />

            <SeekBar
                android:id="@+id/seekbar_front"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/video_front_fallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/text_margin"
            android:text="@string/no_video_available"
            android:visibility="gone" />

        <!-- Consolidated values-at-selected-timestamp readout, filled in when any chart below
             is touched. Not selectable: textIsSelectable makes the view focusable, and setText()
             on every chart touch would otherwise trigger the ScrollView's scroll-to-focused-
             descendant behavior mid-interaction. -->
        <TextView
            android:id="@+id/values_at_timestamp_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/text_margin"
            android:layout_marginBottom="@dimen/text_margin"
            android:focusable="false"
            android:text="Touch a chart below to see every sensor's value at that timestamp." />

        <!-- Gyroscope -->
        <TextView
            android:id="@+id/label_chart_gyro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/text_margin"
            android:text="Gyroscope"
            android:textAppearance="?attr/textAppearanceListItem"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/chart_frame_gyro"
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chart_gyro"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/label_gyro_yaxis_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:text="rad/s"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/label_gyro_xaxis_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:text="s"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/button_zoom_reset_gyro"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reset chart zoom"
                android:src="@drawable/ic_baseline_fit_screen_24" />

        </FrameLayout>

        <TextView
            android:id="@+id/chart_gyro_fallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/text_margin"
            android:visibility="gone" />

        <!-- Accelerometer -->
        <TextView
            android:id="@+id/label_chart_accel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/text_margin"
            android:text="Accelerometer"
            android:textAppearance="?attr/textAppearanceListItem"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/chart_frame_accel"
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chart_accel"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/label_accel_yaxis_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:text="m/s²"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/label_accel_xaxis_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:text="s"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/button_zoom_reset_accel"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reset chart zoom"
                android:src="@drawable/ic_baseline_fit_screen_24" />

        </FrameLayout>

        <TextView
            android:id="@+id/chart_accel_fallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/text_margin"
            android:visibility="gone" />

        <!-- Orientation -->
        <TextView
            android:id="@+id/label_chart_orientation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/text_margin"
            android:text="Orientation"
            android:textAppearance="?attr/textAppearanceListItem"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/chart_frame_orientation"
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chart_orientation"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/label_orientation_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:text="deg"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/label_orientation_xaxis_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:text="s"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/button_zoom_reset_orientation"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reset chart zoom"
                android:src="@drawable/ic_baseline_fit_screen_24" />

        </FrameLayout>

        <TextView
            android:id="@+id/chart_orientation_fallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/text_margin"
            android:visibility="gone" />

        <!-- GPS -->
        <TextView
            android:id="@+id/label_chart_gps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/text_margin"
            android:text="GPS"
            android:textAppearance="?attr/textAppearanceListItem"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/chart_frame_gps"
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chart_gps"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/label_gps_left_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:text="m"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/label_gps_right_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="36dp"
                android:layout_marginEnd="4dp"
                android:text="m/s"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/label_gps_xaxis_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:text="s"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/button_zoom_reset_gps"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reset chart zoom"
                android:src="@drawable/ic_baseline_fit_screen_24" />

        </FrameLayout>

        <TextView
            android:id="@+id/chart_gps_fallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/text_margin"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
