<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="Camera Settings"
        app:iconSpaceReserved="false">

        <SwitchPreference
            android:key="switchManualControl"
            android:summaryOff="Off"
            android:summaryOn="On"
            android:title="Manually Control ISO and Exposure"
            app:iconSpaceReserved="false" />

        <!--        <ListPreference-->
        <!--            android:key="prefFocusDistance"-->
        <!--            android:title="Adjust Focus Distances"-->
        <!--            android:summary="Lock the focus distance (mm) before tap to focus" />-->

        <EditTextPreference
            android:dialogTitle="Adjust ISO"
            android:key="prefISO"
            android:summary="Lock ISO to a custom value"
            android:title="Adjust ISO"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:dialogTitle="Adjust exposure time"
            android:key="prefExposureTime"
            android:summary="Lock exposure time to a custom value"
            android:title="Adjust Exposure Time"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:key="prefCamera"
            android:summary="%s"
            android:title="Main Camera"
            app:iconSpaceReserved="false" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="prefEnableFrontCamera"
            android:summaryOff="Off (back camera only)"
            android:summaryOn="On (records both cameras)"
            android:title="Enable Front Camera"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:dependency="prefEnableFrontCamera"
            android:key="prefCamera2"
            android:summary="%s"
            android:title="Secondary Camera"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:key="prefSizeRaw"
            android:summary="%s"
            android:title="Frame Size"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="IMU Settings"
        app:iconSpaceReserved="false">

        <ListPreference
            android:defaultValue="1"
            android:entries="@array/imuFreq"
            android:entryValues="@array/imuFreqValues"
            android:key="prefImuFreq"
            android:summary="Frequency the IMU is sampled at"
            android:title="IMU Frequency"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="Streaming Settings"
        app:iconSpaceReserved="false">

        <SwitchPreference
            android:defaultValue="false"
            android:key="prefEnableStreaming"
            android:summaryOff="Off"
            android:summaryOn="On (streams video + telemetry over local WiFi — no authentication, anyone on your network can view)"
            android:title="Enable Live Streaming"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:defaultValue="8080"
            android:dependency="prefEnableStreaming"
            android:key="prefStreamPort"
            android:summary="Port the phone listens on for the PC client"
            android:title="Streaming Port"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:defaultValue="5"
            android:dependency="prefEnableStreaming"
            android:key="prefStreamFps"
            android:summary="Target frames per second for the live video stream"
            android:title="Stream Frame Rate"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="Display Settings"
        app:iconSpaceReserved="false">

        <SwitchPreference
            android:defaultValue="false"
            android:key="prefHideOverlayInfo"
            android:summaryOff="Off (camera params, output dir, GPS/streaming status shown on screen)"
            android:summaryOn="On (hides on-screen camera/GPS/streaming info text)"
            android:title="Hide Overlay Info"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:defaultValue="deg"
            android:entries="@array/orientationUnits"
            android:entryValues="@array/orientationUnitsValues"
            android:key="prefOrientationUnits"
            android:summary="%s"
            android:title="Angular Units"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>
</PreferenceScreen>